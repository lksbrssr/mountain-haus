# Shared password for the whole site (the "pretty password link" gate).
SITE_PASSWORD=serenity

# Separate secret for the private owner /admin area (invoices, contacts, meter
# readings, maintenance calendar). If set, /admin requires this instead of
# SITE_PASSWORD — so you can share the guest site without exposing admin.
# Two ways in:
#   1. Type it into the /admin login form, OR
#   2. Cryptic link: bookmark  /admin?key=THE_VALUE_BELOW  and it auto-unlocks
#      (the key is stripped from the URL and a 30-day cookie is set).
# Make this a long random string to get an effectively unguessable link, e.g.
#   openssl rand -hex 24
# If unset, /admin falls back to the SITE_PASSWORD gate.
ADMIN_PASSWORD=reitberg16

# Optional: Google Apps Script web-app URL that appends reservations to a Google Sheet.
# See README "Wiring up the Google Sheet". If unset, requests are logged server-side
# and the site still works (useful for local dev / first deploy).
SHEETS_WEBHOOK_URL=

# Optional shared secret also sent to the Apps Script so random people can't POST to your sheet.
SHEETS_WEBHOOK_SECRET=

# Comments backend (Fly.io). Set in Vercel too. Leave unset for localStorage-only mode.
NEXT_PUBLIC_COMMENTS_API=https://mountain-haus-comments.fly.dev

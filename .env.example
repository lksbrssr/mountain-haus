# Shared password for the whole site (the "pretty password link" gate).
SITE_PASSWORD=serenity

# Optional: Google Apps Script web-app URL that appends reservations to a Google Sheet.
# See README "Wiring up the Google Sheet". If unset, requests are logged server-side
# and the site still works (useful for local dev / first deploy).
SHEETS_WEBHOOK_URL=

# Optional shared secret also sent to the Apps Script so random people can't POST to your sheet.
SHEETS_WEBHOOK_SECRET=
